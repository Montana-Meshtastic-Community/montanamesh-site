@model ErrorViewModel
@{
    ViewData["Title"] = ViewData["Title"] ?? "Site Error";
}

<section class="app-shell page-hero reveal" aria-labelledby="error-title">
    <p class="eyebrow">Site Status</p>
    <h1 id="error-title">Something dropped.</h1>
    <p>
        The site could not complete that request. Try one of the main MontanaMesh routes below, or check back in a minute if the service is being updated.
    </p>
</section>

@if (Model.ShowRequestId)
{
    <section class="app-shell decision-strip reveal" aria-label="Request reference">
        <div>
            <p class="eyebrow">Reference</p>
            <h2>Request ID</h2>
        </div>
        <div class="decision-list">
            <p><code>@Model.RequestId</code></p>
        </div>
    </section>
}

<section class="app-shell route-rail reveal" aria-labelledby="error-next-title">
    <div>
        <p class="eyebrow">Back Online</p>
        <h2 id="error-next-title">Pick a route.</h2>
    </div>
    <div class="route-list">
        <a asp-controller="Home" asp-action="Index">
            <span>Go home</span>
            <small>Return to the MontanaMesh homepage.</small>
        </a>
        <a asp-controller="Home" asp-action="Resources">
            <span>Open resources</span>
            <small>Find maps, docs, guides, and community links.</small>
        </a>
    </div>
</section>
