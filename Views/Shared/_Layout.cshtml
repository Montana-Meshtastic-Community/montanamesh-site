@{
    var backgroundKey = (ViewData["BackgroundKey"] as string) ?? "billings";
    var siteName = "Montana Meshtastic Community";
    var pageTitle = (ViewData["Title"] as string) ?? siteName;
    var fullTitle = pageTitle == siteName ? siteName : $"{pageTitle} | {siteName}";
    var metaDescription = (ViewData["MetaDescription"] as string) ?? "MontanaMesh is a volunteer Meshtastic community building practical off-grid LoRa messaging coverage around Billings and across Montana.";
    var backgroundImagePath = backgroundKey switch
    {
        "missoula" => "/assets/images/backgrounds/missoula.webp",
        "great-falls" => "/assets/images/backgrounds/great-falls-central-ave.webp",
        "bozeman" => "/assets/images/backgrounds/bozeman-main-st.webp",
        "butte" => "/assets/images/backgrounds/butte-uptown.webp",
        _ => "/assets/images/backgrounds/billings-skyline-2024.webp"
    };
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@fullTitle</title>
    <meta name="description" content="@metaDescription" />
    <link rel="icon" type="image/png" href="~/assets/images/favicon.png" />
    <link rel="preload" href="~/assets/fonts/iosevka-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/assets/fonts/iosevka-bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="@backgroundImagePath" as="image" type="image/webp" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="page-@backgroundKey">
    <a class="skip-nav" href="#main">Skip to content</a>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg app-header" aria-label="Primary navigation">
            <div class="container-fluid app-shell">
                <a class="navbar-brand brand-mark" asp-controller="Home" asp-action="Index">
                    <img src="~/assets/images/logo.png" alt="Montana Mesh logo" width="34" height="34" />
                    <span class="brand-copy">
                        <span class="brand-kicker">Montana</span>
                        <span class="brand-name">Meshtastic Community</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item dropdown">
                            <button class="nav-link nav-pill nav-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">About</button>
                            <ul class="dropdown-menu dropdown-menu-end app-dropdown-menu">
                                <li><a class="dropdown-item app-dropdown-item" asp-controller="Home" asp-action="Setup">Setup</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <button class="nav-link nav-pill nav-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Join</button>
                            <ul class="dropdown-menu dropdown-menu-end app-dropdown-menu">
                                <li><a class="dropdown-item app-dropdown-item" asp-controller="Home" asp-action="Connect">How To Connect</a></li>
                                <li><a class="dropdown-item app-dropdown-item" asp-controller="Home" asp-action="HostNode">Host a Node</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <button class="nav-link nav-pill nav-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Devices</button>
                            <ul class="dropdown-menu dropdown-menu-end app-dropdown-menu">
                                <li><a class="dropdown-item app-dropdown-item" asp-controller="Home" asp-action="DeviceGuide">Device Guide</a></li>
                                <li><a class="dropdown-item app-dropdown-item" asp-controller="Home" asp-action="OptimalSettings">Optimal Settings</a></li>
                                <li><a class="dropdown-item app-dropdown-item" asp-controller="Home" asp-action="RecommendedConfigurationSettings">Recommended Setup</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <button class="nav-link nav-pill nav-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Resources</button>
                            <ul class="dropdown-menu dropdown-menu-end app-dropdown-menu">
                                <li><a class="dropdown-item app-dropdown-item" asp-controller="Home" asp-action="Resources">Local Resources</a></li>
                                <li><a class="dropdown-item app-dropdown-item" asp-controller="Home" asp-action="OtherMeshNetworks">Other Mesh Networks</a></li>
                                <li><a class="dropdown-item app-dropdown-item" href="https://meshtastic.org/docs/" target="_blank" rel="noopener noreferrer">Meshtastic Wiki</a></li>
                            </ul>
                        </li>
                        <li class="nav-item ms-lg-5 mt-2 mt-lg-0">
                            <a id="repoStatsLink" class="repo-link" href="https://github.com/Montana-Meshtastic-Community/montanamesh-site" target="_blank" rel="noopener noreferrer">
                                <span class="repo-label">montanamesh-site</span>
                                <span class="repo-stat">Stars <span id="repoStars">-</span></span>
                                <span class="repo-stat">Forks <span id="repoForks">-</span></span>
                            </a>
                        </li>
                        <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                            <button id="themeToggle" type="button" class="btn btn-sm btn-outline-secondary theme-toggle" aria-label="Toggle theme" title="Toggle theme">
                                <span id="themeToggleIcon" aria-hidden="true">☾</span>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="app-content">
        <main id="main" role="main" tabindex="-1">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="app-shell footer-grid">
            <span>Copyright &copy; 2026 Montana Meshtastic Community</span>
            <nav class="footer-links" aria-label="Footer navigation">
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                <span class="footer-meta">Billings first. Montana wide.</span>
            </nav>
        </div>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
