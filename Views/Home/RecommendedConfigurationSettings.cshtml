@{
    var portable = RadioProfile.Portable;
    var baseStation = RadioProfile.BaseStation;
    var router = RadioProfile.Router;
    ViewData["Title"] = "Recommended Meshtastic Settings";
    ViewData["MetaDescription"] = "Use Montana Mesh recommended Meshtastic settings for roles, LoRa, hop limits, position sharing, telemetry, MQTT, security, and clean shared-channel behavior.";
}

<section class="app-shell page-hero reveal" aria-labelledby="settings-title">
    <p class="eyebrow">Shared Air / Cleaner Traffic / LongFast</p>
    <h1 id="settings-title">Recommended settings.</h1>
    <p>
        These defaults are tuned for useful Montana Mesh participation. They keep radios visible, reachable, and polite on the shared channel without turning every node into constant background traffic.
    </p>
</section>

<section class="app-shell settings-grid" aria-label="Recommended device settings">
    <article class="setting-card reveal">
        <span class="card-index">Role</span>
        <h2><code>@portable.Role</code> first</h2>
        <p>Use <code>@portable.Role</code> for most radios. Use <code>@RadioProfile.QuietClientRole</code> when you want to reduce relay load, and use <code>@baseStation.Role</code> for a stable personal base station.</p>
    </article>
    <article class="setting-card reveal">
        <span class="card-index">LoRa</span>
        <h2><code>@RadioProfile.Region</code> / <code>@RadioProfile.ModemPreset</code></h2>
        <p>Use the US 915 MHz region and LongFast preset for the public Montana mesh unless a group deliberately coordinates something else.</p>
    </article>
    <article class="setting-card reveal">
        <span class="card-index">Airtime</span>
        <h2>Broadcast less</h2>
        <p>Long intervals, smart position updates, and fewer optional modules keep the mesh usable as the number of nodes grows.</p>
    </article>
</section>

<section class="app-shell kit-table-wrap reveal" aria-labelledby="core-settings-title">
    <h2 id="core-settings-title">Core settings</h2>
    <p class="table-lede">Start here for nearly every Montana Mesh radio. These settings are intentionally conservative.</p>
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle kit-table">
            <thead>
            <tr>
                <th>Setting</th>
                <th>Recommended Value</th>
                <th>Details</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>Region</td>
                <td><code>@RadioProfile.Region</code></td>
                <td>Use the United States 915 MHz region for Montana.</td>
            </tr>
            <tr>
                <td>Modem preset</td>
                <td><code>@RadioProfile.ModemPreset</code></td>
                <td>The expected public mesh preset for normal Montana Mesh participation.</td>
            </tr>
            <tr>
                <td>Role</td>
                <td><code>@portable.Role</code> or <code>@RadioProfile.QuietClientRole</code></td>
                <td>Best default for most personal, mobile, indoor, and experimental nodes.</td>
            </tr>
            <tr>
                <td>Base station role</td>
                <td><code>@baseStation.Role</code></td>
                <td>Good for a stable home, attic, roofline, or shop node that supports your favorited nearby nodes.</td>
            </tr>
            <tr>
                <td>Router roles</td>
                <td><code>@router.Role</code> or <code>@RadioProfile.LowerPriorityRouterRole</code> only by plan</td>
                <td>Use infrastructure roles only for well-placed, reliable, coordinated coverage sites.</td>
            </tr>
            <tr>
                <td>Hop limit</td>
                <td><code>@portable.HopLimit</code> portable, <code>@baseStation.HopLimit</code> fixed</td>
                <td>Higher hop counts can increase congestion. Avoid higher than <code>6</code> unless there is a specific reason.</td>
            </tr>
            <tr>
                <td>Node info broadcast</td>
                <td><code>@RadioProfile.NodeInfoSeconds</code> seconds</td>
                <td>Keeps names and node info fresh without constant repeated metadata.</td>
            </tr>
            </tbody>
        </table>
    </div>
</section>

<section class="app-shell kit-table-wrap reveal" aria-labelledby="position-settings-title">
    <h2 id="position-settings-title">Position and privacy</h2>
    <p class="table-lede">Position data is useful for maps and testing, but it should be shared deliberately.</p>
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle kit-table">
            <thead>
            <tr>
                <th>Node Type</th>
                <th>Position Recommendation</th>
                <th>Details</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>Portable or vehicle</td>
                <td>Smart position broadcast enabled</td>
                <td>Let moving nodes update intelligently based on movement and timing.</td>
            </tr>
            <tr>
                <td>Home or base station</td>
                <td>Fixed position, approximate if needed</td>
                <td>Use fixed coordinates only at a precision you are comfortable making visible.</td>
            </tr>
            <tr>
                <td>Public router</td>
                <td>Fixed position</td>
                <td>Infrastructure nodes should not send moving GPS updates. Use a deliberate public coordinate.</td>
            </tr>
            <tr>
                <td>Private node</td>
                <td>Position off or reduced precision</td>
                <td>If the node is at a home or sensitive site, do not publish exact coordinates casually.</td>
            </tr>
            </tbody>
        </table>
    </div>
</section>

<section class="app-shell kit-table-wrap reveal" aria-labelledby="module-settings-title">
    <h2 id="module-settings-title">Module etiquette</h2>
    <p class="table-lede">Optional modules are useful, but every broadcast consumes shared LoRa airtime. Enable only what you actually use.</p>
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle kit-table">
            <thead>
            <tr>
                <th>Feature</th>
                <th>Recommended Value</th>
                <th>Details</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>Device metrics telemetry</td>
                <td>Mesh broadcast off, or every <code>@RadioProfile.NodeInfoSeconds</code> seconds or longer</td>
                <td>Current firmware keeps device metrics between the radio and your app unless you turn on mesh broadcasting. Only share battery and voltage on the mesh if someone will use it, and keep the interval long.</td>
            </tr>
            <tr>
                <td>Environment telemetry</td>
                <td>Off unless you have a sensor</td>
                <td>Do not broadcast empty or unneeded sensor reports.</td>
            </tr>
            <tr>
                <td>Neighbor info</td>
                <td>Default or longer interval</td>
                <td>Helpful for topology, but not urgent. Avoid shortening the interval.</td>
            </tr>
            <tr>
                <td>Range test</td>
                <td>Temporary only</td>
                <td>Enable during a planned test, then turn it off when finished.</td>
            </tr>
            <tr>
                <td>Store and forward</td>
                <td>Coordinated infrastructure only</td>
                <td>Useful in the right place, noisy in the wrong place. Coordinate before enabling public service behavior.</td>
            </tr>
            <tr>
                <td>MQTT</td>
                <td>Off unless intentionally configured</td>
                <td>Most radios should focus on RF. Gateways need credentials, map-report choices, and community planning.</td>
            </tr>
            </tbody>
        </table>
    </div>
</section>

<section class="app-shell decision-strip reveal" aria-labelledby="security-title">
    <div>
        <p class="eyebrow">Security</p>
        <h2 id="security-title">Do the boring bits.</h2>
    </div>
    <div class="decision-list">
        <p>Give every radio a clear long name and short name so other operators know what they are seeing.</p>
        <p>If using Bluetooth fixed PIN mode, change the default <code>123456</code> PIN.</p>
        <p>Do not enable legacy insecure admin control unless you understand the risk and need it for a specific setup.</p>
        <p>Keep private channel keys, MQTT passwords, Wi-Fi credentials, and admin keys out of screenshots and public chats.</p>
    </div>
</section>

<section class="app-shell code-panel reveal" aria-labelledby="cli-title">
    <div>
        <p class="eyebrow">CLI Examples</p>
        <h2 id="cli-title">Apply the basics</h2>
        <p class="code-note">Replace <code>LATITUDE</code>, <code>LONGITUDE</code>, and <code>ALTITUDE_METERS</code> with the node's location in decimal degrees and meters. Round the coordinates if you do not want an exact location on public maps.</p>
    </div>
    <pre><code>@RadioProfile.Command(portable.SharedMeshSettings)

@baseStation.FixedNodeCommand</code></pre>
</section>

<section class="app-shell resource-grid compact reveal" aria-label="Official configuration references">
    <a class="resource-card" href="https://meshtastic.org/docs/configuration/radio/device/" target="_blank" rel="noopener noreferrer">
        <span class="card-index">Official Docs</span>
        <h2>Device roles</h2>
        <p>Review current Meshtastic role behavior before changing a node to base station or router-style infrastructure.</p>
    </a>
    <a class="resource-card" href="https://meshtastic.org/docs/configuration/module/telemetry/" target="_blank" rel="noopener noreferrer">
        <span class="card-index">Official Docs</span>
        <h2>Telemetry modules</h2>
        <p>Check current telemetry setting names and defaults before tuning broadcast intervals.</p>
    </a>
</section>

<section class="app-shell route-rail reveal" aria-labelledby="settings-next-title">
    <div>
        <p class="eyebrow">Need Context?</p>
        <h2 id="settings-next-title">Set up with intent.</h2>
    </div>
    <div class="route-list">
        <a asp-controller="Home" asp-action="DeviceGuide">
            <span>Choose hardware</span>
            <small>Match the device to the role before tuning settings.</small>
        </a>
        <a asp-controller="Home" asp-action="OptimalSettings">
            <span>Compare optimal profiles</span>
            <small>Portable, base station, and router settings side by side.</small>
        </a>
        <a asp-controller="Home" asp-action="Connect">
            <span>Connect your radio</span>
            <small>Install the app, pair the device, and run a first test.</small>
        </a>
    </div>
</section>
