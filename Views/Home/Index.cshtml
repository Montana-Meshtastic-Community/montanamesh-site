@{
    ViewData["Title"] = "Home";
}

<section class="hero-section" aria-labelledby="home-title">
    <div class="hero-media" aria-hidden="true"></div>
    <div class="app-shell hero-grid">
        <div class="hero-copy reveal">
            <p class="eyebrow">LongFast / Billings, Montana / 915 MHz</p>
            <h1 id="home-title">Montana's off-grid message network is taking shape.</h1>
            <p class="hero-lede">
                A volunteer-built Meshtastic community connecting Billings, the Heights, Laurel, and the rest of Montana through practical LoRa radio coverage.
            </p>
            <div class="hero-actions" aria-label="Primary actions">
                <a class="btn btn-primary signal-button" href="https://discord.gg/SKmsDCraTV" target="_blank" rel="noopener noreferrer">Join Discord</a>
                <a class="btn btn-outline-light signal-button" href="https://meshmonitor.montanamesh.com" target="_blank" rel="noopener noreferrer">Open Live Map</a>
                <a class="text-link" asp-controller="Home" asp-action="Connect">Start with a radio</a>
            </div>
        </div>

        <aside class="telemetry-panel reveal" aria-label="Live network telemetry">
            <div class="panel-header">
                <span>Network Pulse</span>
                <span class="status-dot" aria-hidden="true"></span>
            </div>
            <div class="primary-stat">
                <span class="stat-label">Total Nodes</span>
                <strong id="totalNodes" class="stat-value" aria-live="polite">Loading</strong>
            </div>
            <div class="mini-stats">
                <article>
                    <span>30 min</span>
                    <strong id="nodes30min" aria-live="polite">--</strong>
                </article>
                <article>
                    <span>2 hr</span>
                    <strong id="nodes2hr" aria-live="polite">--</strong>
                </article>
                <article>
                    <span>24 hr</span>
                    <strong id="nodes24hr" aria-live="polite">--</strong>
                </article>
            </div>
            <p class="panel-note">Updated from MontanaMesh MQTT traffic. Best viewed with a radio, an antenna, and a clear bit of sky.</p>
        </aside>
    </div>
</section>

<section class="app-shell intro-band reveal" aria-labelledby="mission-title">
    <div>
        <p class="eyebrow">Community Infrastructure</p>
        <h2 id="mission-title">Built for real people, real terrain, and the weird day when cell service is gone.</h2>
    </div>
    <p>
        Whether you are a ham operator, hiker, tinkerer, emergency volunteer, or simply curious about resilient local communications, Montana Mesh is a place to learn, test, and add useful coverage.
    </p>
</section>

<section class="app-shell signal-grid" aria-label="MontanaMesh overview">
    <article class="signal-card reveal">
        <span class="card-index">01</span>
        <h2>What Is Meshtastic?</h2>
        <p>
            Meshtastic is an open-source communication system built around small LoRa radios. Devices can send text messages, location updates, and basic telemetry without cell service, Wi-Fi, or traditional internet.
        </p>
        <p>
            Nearby radios repeat traffic for each other, so coverage improves as more well-placed nodes appear on rooftops, vehicles, hills, and high windows.
        </p>
    </article>
    <article class="signal-card reveal">
        <span class="card-index">02</span>
        <h2>Who Are We?</h2>
        <p>
            Montana Mesh is volunteer-led and focused on growing useful coverage around Billings first, then helping nearby communities connect their own local meshes.
        </p>
        <p>
            The project depends on people donating time, gear, site access, installation help, and local knowledge.
        </p>
    </article>
    <article class="signal-card reveal">
        <span class="card-index">03</span>
        <h2>Where This Goes</h2>
        <p>
            The long-term goal is reliable Meshtastic presence across Montana's major cities, with responsible MQTT links where they help coordination without crowding local radio traffic.
        </p>
    </article>
</section>

<section class="app-shell route-rail reveal" aria-labelledby="next-title">
    <div>
        <p class="eyebrow">Next Steps</p>
        <h2 id="next-title">Pick your entry point.</h2>
    </div>
    <div class="route-list">
        <a asp-controller="Home" asp-action="Connect">
            <span>Get connected</span>
            <small>Hardware, app setup, and first radio guidance.</small>
        </a>
        <a asp-controller="Home" asp-action="HostNode">
            <span>Host a node</span>
            <small>Use a roof, window, shop, or hilltop to improve local coverage.</small>
        </a>
        <a asp-controller="Home" asp-action="RecommendedConfigurationSettings">
            <span>Configure cleanly</span>
            <small>Recommended settings that keep the shared channel usable.</small>
        </a>
        <a asp-controller="Home" asp-action="Resources">
            <span>Use the network</span>
            <small>Maps, docs, dashboards, and regional groups.</small>
        </a>
    </div>
</section>

<section class="app-shell faq-section reveal" aria-labelledby="faq-title">
    <div class="faq-heading">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-title">Common first questions</h2>
    </div>
    <div class="faq-grid">
        <article>
            <h3>Do I need a license?</h3>
            <p>No amateur radio license is required for normal Meshtastic use on the US 915 MHz ISM band, as long as you use legal hardware and settings.</p>
        </article>
        <article>
            <h3>Does it work without cell service?</h3>
            <p>Yes. Radios talk over LoRa directly and relay through nearby nodes. Your phone is mostly the screen and keyboard.</p>
        </article>
        <article>
            <h3>How far will it reach?</h3>
            <p>Range depends on terrain, antenna height, buildings, and line of sight. A hilltop or rooftop can hear much farther than a radio in a pocket.</p>
        </article>
        <article>
            <h3>Can I hide my location?</h3>
            <p>Yes. Location sharing is configurable. For public fixed nodes, share only what you are comfortable publishing.</p>
        </article>
        <article>
            <h3>What channel should I use?</h3>
            <p>Start with the local LongFast setup and the MontanaMesh recommended settings so your radio plays nicely with the shared mesh.</p>
        </article>
        <article>
            <h3>Where do I ask for help?</h3>
            <p>Join the Montana Mesh Discord. It is the best place to compare hardware, test coverage, and coordinate useful node locations.</p>
        </article>
    </div>
</section>

@section Scripts {
    <script src="~/js/nodeData.js" asp-append-version="true"></script>
}
